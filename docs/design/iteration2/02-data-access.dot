digraph UML {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.55", ranksep="0.8", splines=polyline, overlap=false];
node [shape=plain, fontname="Microsoft YaHei", fontsize=11];
edge [fontname="Microsoft YaHei", fontsize=9, color="#64748b", arrowsize=0.7];
fontname="Microsoft YaHei"; fontsize=16;
UserDao [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="190" COLOR="#315b87"><TR><TD WIDTH="188" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;interface&gt;&gt;<BR/><B>UserDao</B></TD></TR><TR><TD WIDTH="188" ALIGN="LEFT" CELLPADDING="7">+ findById(...)<BR ALIGN="LEFT"/>+ findByUsername(...)<BR ALIGN="LEFT"/>+ insert(...)<BR ALIGN="LEFT"/>+ updatePassword(...)<BR ALIGN="LEFT"/>+ updateCreditScore(...)<BR ALIGN="LEFT"/>+ updateStatus(...)<BR ALIGN="LEFT"/>+ updateLastLogin(...)<BR ALIGN="LEFT"/>+ findByPage(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
