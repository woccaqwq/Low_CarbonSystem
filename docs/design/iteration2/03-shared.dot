digraph UML {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.55", ranksep="0.8", splines=polyline, overlap=false];
node [shape=plain, fontname="Microsoft YaHei", fontsize=11];
edge [fontname="Microsoft YaHei", fontsize=9, color="#64748b", arrowsize=0.7];
fontname="Microsoft YaHei"; fontsize=16;
SessionUser [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="207" COLOR="#315b87"><TR><TD WIDTH="205" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;immutable snapshot&gt;&gt;<BR/><B>SessionUser</B></TD></TR><TR><TD WIDTH="205" ALIGN="LEFT" CELLPADDING="7">- userId : int {final}<BR ALIGN="LEFT"/>- username : String {final}<BR ALIGN="LEFT"/>- nickname : String {final}<BR ALIGN="LEFT"/>- role : Role {final}<BR ALIGN="LEFT"/>- creditScore : int {final}<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="205" ALIGN="LEFT" CELLPADDING="7">+ from(...)<BR ALIGN="LEFT"/>+ isAdmin(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
OperationLog [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="207" COLOR="#315b87"><TR><TD WIDTH="205" BGCOLOR="#dce9f8" CELLPADDING="8"><B>OperationLog</B></TD></TR><TR><TD WIDTH="205" ALIGN="LEFT" CELLPADDING="7">- logId : int<BR ALIGN="LEFT"/>- userId : Integer<BR ALIGN="LEFT"/>- action : String<BR ALIGN="LEFT"/>- detail : String<BR ALIGN="LEFT"/>- createdAt : LocalDateTime<BR ALIGN="LEFT"/>- username : String<BR ALIGN="LEFT"/>- nickname : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SysConfig [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="261" COLOR="#315b87"><TR><TD WIDTH="259" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;immutable&gt;&gt;<BR/><B>SysConfig</B></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT" CELLPADDING="7">- configKey : String {final}<BR ALIGN="LEFT"/>- configValue : String {final}<BR ALIGN="LEFT"/>- updatedAt : LocalDateTime {final}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
StatQuery [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="201" COLOR="#315b87"><TR><TD WIDTH="199" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;immutable&gt;&gt;<BR/><B>StatQuery</B></TD></TR><TR><TD WIDTH="199" ALIGN="LEFT" CELLPADDING="7">- from : LocalDate {final}<BR ALIGN="LEFT"/>- to : LocalDate {final}<BR ALIGN="LEFT"/>- userId : Integer {final}<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="199" ALIGN="LEFT" CELLPADDING="7">+ builder(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
StatCounts [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="261" COLOR="#315b87"><TR><TD WIDTH="259" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;immutable&gt;&gt;<BR/><B>StatCounts</B></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT" CELLPADDING="7">- onSaleItemCount : long {final}<BR ALIGN="LEFT"/>- offShelfItemCount : long {final}<BR ALIGN="LEFT"/>- flowedItemCount : long {final}<BR ALIGN="LEFT"/>- pendingFlowCount : long {final}<BR ALIGN="LEFT"/>- dealFlowCount : long {final}<BR ALIGN="LEFT"/>- cancelledFlowCount : long {final}<BR ALIGN="LEFT"/>- itemCount : long {final}<BR ALIGN="LEFT"/>- flowCount : long {final}<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT" CELLPADDING="7">+ getItemCount(...)<BR ALIGN="LEFT"/>+ getFlowCount(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CategoryStat [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="234" COLOR="#315b87"><TR><TD WIDTH="232" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;immutable&gt;&gt;<BR/><B>CategoryStat</B></TD></TR><TR><TD WIDTH="232" ALIGN="LEFT" CELLPADDING="7">- categoryId : Integer {final}<BR ALIGN="LEFT"/>- categoryName : String {final}<BR ALIGN="LEFT"/>- counts : StatCounts {final}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MonthStat [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="221" COLOR="#315b87"><TR><TD WIDTH="219" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;immutable&gt;&gt;<BR/><B>MonthStat</B></TD></TR><TR><TD WIDTH="219" ALIGN="LEFT" CELLPADDING="7">- month : YearMonth {final}<BR ALIGN="LEFT"/>- counts : StatCounts {final}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
StatOverview [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="274" COLOR="#315b87"><TR><TD WIDTH="272" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;immutable&gt;&gt;<BR/><B>StatOverview</B></TD></TR><TR><TD WIDTH="272" ALIGN="LEFT" CELLPADDING="7">- counts : StatCounts {final}<BR ALIGN="LEFT"/>- userCount : long {final}<BR ALIGN="LEFT"/>- averageCreditScore : double {final}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ErrorCode [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="201" COLOR="#315b87"><TR><TD WIDTH="199" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;enum&gt;&gt;<BR/><B>ErrorCode</B></TD></TR><TR><TD WIDTH="199" ALIGN="LEFT" CELLPADDING="7">- message : String {final}<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="199" ALIGN="LEFT" CELLPADDING="7">+ getMessage(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
BusinessException [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="201" COLOR="#315b87"><TR><TD WIDTH="199" BGCOLOR="#dce9f8" CELLPADDING="8"><B>BusinessException</B></TD></TR><TR><TD WIDTH="199" ALIGN="LEFT" CELLPADDING="7">- code : ErrorCode {final}<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="199" ALIGN="LEFT" CELLPADDING="7">+ getCode(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ValidationException [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="190" COLOR="#315b87"><TR><TD WIDTH="188" BGCOLOR="#dce9f8" CELLPADDING="8"><B>ValidationException</B></TD></TR><TR><TD WIDTH="188" ALIGN="LEFT" CELLPADDING="7">- field : String {final}<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="188" ALIGN="LEFT" CELLPADDING="7">+ getField(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DataAccessException [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="190" COLOR="#315b87"><TR><TD WIDTH="188" BGCOLOR="#dce9f8" CELLPADDING="8"><B>DataAccessException</B></TD></TR></TABLE>>];
CsvExporter [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="190" COLOR="#315b87"><TR><TD WIDTH="188" BGCOLOR="#dce9f8" CELLPADDING="8"><B>CsvExporter</B></TD></TR><TR><TD WIDTH="188" ALIGN="LEFT" CELLPADDING="7">+ export(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AppLogger [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="328" COLOR="#315b87"><TR><TD WIDTH="326" BGCOLOR="#dce9f8" CELLPADDING="8"><B>AppLogger</B></TD></TR><TR><TD WIDTH="326" ALIGN="LEFT" CELLPADDING="7">- clock : Clock {final}<BR ALIGN="LEFT"/>- delegate : java.util.logging.Logger {final}<BR ALIGN="LEFT"/>- handler : DailyLogHandler {final}<BR ALIGN="LEFT"/>- closed : boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="326" ALIGN="LEFT" CELLPADDING="7">+ log(...)<BR ALIGN="LEFT"/>+ close(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DailyLogHandler [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="261" COLOR="#315b87"><TR><TD WIDTH="259" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;internal&gt;&gt;<BR/><B>DailyLogHandler</B></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT" CELLPADDING="7">- directory : Path {final}<BR ALIGN="LEFT"/>- zone : ZoneId {final}<BR ALIGN="LEFT"/>- lockChannel : FileChannel {final}<BR ALIGN="LEFT"/>- directoryLock : FileLock {final}<BR ALIGN="LEFT"/>- writer : BufferedWriter<BR ALIGN="LEFT"/>- openDate : LocalDate<BR ALIGN="LEFT"/>- closed : boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT" CELLPADDING="7">+ publish(...)<BR ALIGN="LEFT"/>+ close(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SafeLogFormatter [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" WIDTH="288" COLOR="#315b87"><TR><TD WIDTH="286" BGCOLOR="#dce9f8" CELLPADDING="8">&lt;&lt;internal&gt;&gt;<BR/><B>SafeLogFormatter</B></TD></TR><TR><TD WIDTH="286" ALIGN="LEFT" CELLPADDING="7">- timestamp : DateTimeFormatter {final}<BR ALIGN="LEFT"/></TD></TR><TR><TD WIDTH="286" ALIGN="LEFT" CELLPADDING="7">+ format(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CategoryStat -> StatCounts [xlabel="counts",taillabel="0..*",headlabel="1",constraint=false,arrowhead=none];
MonthStat -> StatCounts [xlabel="counts",taillabel="0..*",headlabel="1",constraint=false,arrowhead=none];
StatOverview -> StatCounts [xlabel="counts",taillabel="0..*",headlabel="1",constraint=false,arrowhead=none];
ValidationException -> BusinessException [xlabel="extends",taillabel="",headlabel="",constraint=false,arrowhead=empty];
BusinessException -> ErrorCode [xlabel="fixed message",taillabel="",headlabel="",constraint=false,style=dashed,arrowhead=vee];
AppLogger -> DailyLogHandler [xlabel="owns / closes",taillabel="",headlabel="",constraint=false,dir=both,arrowtail=diamond,arrowhead=none];
DailyLogHandler -> SafeLogFormatter [xlabel="formats",taillabel="",headlabel="",constraint=false,style=dashed,arrowhead=vee];
{rank=same; SessionUser;OperationLog;SysConfig;StatQuery;}
SessionUser -> OperationLog [style=invis,weight=100];
OperationLog -> SysConfig [style=invis,weight=100];
SysConfig -> StatQuery [style=invis,weight=100];
{rank=same; CategoryStat;MonthStat;StatOverview;StatCounts;}
CategoryStat -> MonthStat [style=invis,weight=100];
MonthStat -> StatOverview [style=invis,weight=100];
StatOverview -> StatCounts [style=invis,weight=100];
{rank=same; ValidationException;BusinessException;ErrorCode;DataAccessException;}
ValidationException -> BusinessException [style=invis,weight=100];
BusinessException -> ErrorCode [style=invis,weight=100];
ErrorCode -> DataAccessException [style=invis,weight=100];
{rank=same; CsvExporter;AppLogger;DailyLogHandler;SafeLogFormatter;}
CsvExporter -> AppLogger [style=invis,weight=100];
AppLogger -> DailyLogHandler [style=invis,weight=100];
DailyLogHandler -> SafeLogFormatter [style=invis,weight=100];
SessionUser -> CategoryStat [style=invis,weight=100,minlen=2];
CategoryStat -> ValidationException [style=invis,weight=100,minlen=2];
ValidationException -> CsvExporter [style=invis,weight=100,minlen=2];
}
