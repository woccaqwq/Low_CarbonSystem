digraph states { graph [rankdir=LR,bgcolor="white",pad="0.4"]; node [shape=box,style="rounded,filled",fillcolor="#e5effb",fontname="Microsoft YaHei"]; edge [fontname="Microsoft YaHei"]; subgraph cluster_item { label="ItemStatus (entity guards)"; ON_SALE -> OFF_SHELF [label="offline()"]; OFF_SHELF -> ON_SALE [label="publish()"]; ON_SALE -> FLOWED [label="markFlowed()"]; } subgraph cluster_flow { label="FlowStatus"; PENDING -> DEAL [label="confirm()"]; PENDING -> CANCELLED [label="cancel(reason)"]; } FLOWED [peripheries=2]; DEAL [peripheries=2]; CANCELLED [peripheries=2]; }
